<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEF2FF"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FCD34D">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/itemTvRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#B45309"
                    android:layout_gravity="center"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/itemTvClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="82dp"
                    android:text="Class Name"
                    android:textColor="#1E293B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemTvClassCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code: ----"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#6366F1"
                    android:background="#EEF2FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/itemTvHomeworkTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Homework Assigned"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp"/>

            <ProgressBar
                android:id="@+id/itemProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:progress="0"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>